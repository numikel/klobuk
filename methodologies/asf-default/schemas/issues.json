{
  "type": "object",
  "additionalProperties": false,
  "required": ["epic", "tasks"],
  "properties": {
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": { "title": { "type": "string" }, "body": { "type": "string" } }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "body", "file_scope", "acceptance", "depends_on"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "file_scope": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "estimate": { "type": "string", "enum": ["XS", "S", "M", "L"] }
        }
      }
    }
  }
}
